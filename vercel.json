{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "style.css",
          "app.js",
          "app_lb.js",
          "admin_dashboard.html",
          "admin_login.html",
          "index.html",
          "index_lb.html",
          "check_status.html"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
